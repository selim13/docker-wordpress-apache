APACHE_SERVER_ADMIN=test@localhost
APACHE_DOCUMENT_ROOT=/var/www/html
PHP_DATE_TIMEZONE=Europe/Moscow
PHP_DISPLAY_ERRORS=1
PHP_ERROR_REPORTING=E_ALL
PHP_MAX_EXECUTION_TIME=800
PHP_MAX_FILE_UPLOADS=1000
PHP_MEMORY_LIMIT=512M
PHP_POST_MAX_SIZE=5000M
PHP_UPLOAD_MAX_FILESIZE=5000M
PHP_SESSION_GC_MAXLIFETIME=86400
PHP_OPCACHE_ENABLE=0
PHP_OPCACHE_ENABLE_CLI=0
PHP_OPCACHE_MEMORY_CONSUMPTION=512
PHP_OPCACHE_MAX_ACCELERATED_FILES=100000
PHP_OPCACHE_MAX_FILE_SIZE=2097252
PHP_OPCACHE_REVALIDATE_FREQ=0
PHP_OPCACHE_JIT_BUFFER_SIZE=128M
PHP_XDEBUG_MODE=debug,develop
PHP_XDEBUG_START_WITH_REQUEST=yes
